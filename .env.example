# Variables de entorno de Knit&Crochet.
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env*` con secretos al repositorio.

# --- Base de datos (Neon / Postgres) --- (feature #2)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# --- Autenticación JWT propia --- (feature #4)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Cloudinary (subida de imágenes → se guarda solo la URL) --- (feature #5)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
